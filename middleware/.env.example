# Copy to .env (git-ignored). Never commit real keys.

# Which model provider the tool-call loop uses: gemini | groq | openrouter | ollama | replay
LLM_PROVIDER=replay
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Mock services (the checks set these automatically; set them when running by hand)
CRM_URL=http://127.0.0.1:8001
EMAIL_URL=http://127.0.0.1:8002
PAYMENTS_URL=http://127.0.0.1:8003

# Module 3: the CRM "integration secret" the settings module must never log
CRM_API_KEY=lsfp_test_key_do_not_log

# Module 3.2: bearer tokens the HTTP server accepts, with their scopes.
#   token:scope[,scope];token:scope...   Scopes: donors:read donors:write donors:approve
MCP_TOKENS=staff-read-token:donors:read;staff-write-token:donors:read,donors:write;director-token:donors:read,donors:write,donors:approve
# Scopes a local stdio host gets (no HTTP auth context). Default donors:read.
MCP_LOCAL_SCOPES=donors:read
# Module 3.3: where pending approvals live
APPROVALS_DB=approvals.db

# Module 4.3: where task rows live
TASKS_DB=tasks.db

# Module 5.1: the consolidated state database (migrations in tools/migrations)
STATE_DB=state.db
