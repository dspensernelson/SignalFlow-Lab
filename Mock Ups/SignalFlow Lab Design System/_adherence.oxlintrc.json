{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/core/**",
              "components/lesson/**",
              "components/workflow/**",
              "ui_kits/signalflow-lab/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|icon|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:context|locked|ready|progress|complete|info|neutral)$/]",
        "message": "<Badge> tone must be one of 'context' | 'locked' | 'ready' | 'progress' | 'complete' | 'info' | 'neutral'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|icon|iconRight|fullWidth|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, icon, iconRight, fullWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|success|warning|neutral|ghost|link)$/]",
        "message": "<Button> variant must be one of 'primary' | 'success' | 'warning' | 'neutral' | 'ghost' | 'link'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Button> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|padding|accent|shadow|key|ref|className|style|children)$/]",
        "message": "<Card> doesn't accept that prop. Declared props: tone, padding, accent, shadow."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|success|warning|info|subtle)$/]",
        "message": "<Card> tone must be one of 'default' | 'success' | 'warning' | 'info' | 'subtle'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Card'] > JSXAttribute[name.name='padding'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Card> padding must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Chip'] > JSXAttribute > JSXIdentifier[name!=/^(?:mono|key|ref|className|style|children)$/]",
        "message": "<Chip> doesn't accept that prop. Declared props: mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='CodeBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|wrap|key|ref|className|style|children)$/]",
        "message": "<CodeBlock> doesn't accept that prop. Declared props: children, wrap."
      },
      {
        "selector": "JSXOpeningElement[name.name='FieldGuideRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:field|type|meaning|example|hint|divider|className|style|key|ref|className|style|children)$/]",
        "message": "<FieldGuideRow> doesn't accept that prop. Declared props: field, type, meaning, example, hint, divider, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Icon'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|size|strokeWidth|key|ref|className|style|children)$/]",
        "message": "<Icon> doesn't accept that prop. Declared props: name, size, strokeWidth."
      },
      {
        "selector": "JSXOpeningElement[name.name='Logo'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|showWordmark|wordmark|uppercase|color|className|style|key|ref|className|style|children)$/]",
        "message": "<Logo> doesn't accept that prop. Declared props: size, showWordmark, wordmark, uppercase, color, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:as|size|key|ref|className|style|children)$/]",
        "message": "<SectionLabel> doesn't accept that prop. Declared props: as, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='SectionLabel'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|xs)$/]",
        "message": "<SectionLabel> size must be one of 'sm' | 'xs'."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:icon|value|label|tone|key|ref|className|style|children)$/]",
        "message": "<StatItem> doesn't accept that prop. Declared props: icon, value, label, tone."
      },
      {
        "selector": "JSXOpeningElement[name.name='StatItem'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:default|complete|ready|progress|locked|accent)$/]",
        "message": "<StatItem> tone must be one of 'default' | 'complete' | 'ready' | 'progress' | 'locked' | 'accent'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Stepper'] > JSXAttribute > JSXIdentifier[name!=/^(?:steps|current|className|style|key|ref|className|style|children)$/]",
        "message": "<Stepper> doesn't accept that prop. Declared props: steps, current, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|className|style|key|ref|className|style|children)$/]",
        "message": "<ThemeToggle> doesn't accept that prop. Declared props: value, onChange, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='ThemeToggle'] > JSXAttribute[name.name='value'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<ThemeToggle> value must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='ValidationRow'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|message|passed|hint|className|style|key|ref|className|style|children)$/]",
        "message": "<ValidationRow> doesn't accept that prop. Declared props: label, message, passed, hint, className, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkflowNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:type|label|artifactName|status|relation|dimmed|icon|key|ref|className|style|children)$/]",
        "message": "<WorkflowNode> doesn't accept that prop. Declared props: type, label, artifactName, status, relation, dimmed, icon."
      },
      {
        "selector": "JSXOpeningElement[name.name='WorkflowNode'] > JSXAttribute[name.name='relation'] > Literal[value!=/^(?:selected|upstream|downstream|none)$/]",
        "message": "<WorkflowNode> relation must be one of 'selected' | 'upstream' | 'downstream' | 'none'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
