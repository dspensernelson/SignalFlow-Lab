    "lint:giveaway": "node scripts/lint-giveaway.mjs",
    "lint:glossary": "node scripts/lint-glossary.mjs",
    "test:lessons": "node scripts/validate-lessons.mjs",
    "test:validators": "node scripts/test-validators.mjs",
    "test:runtime": "node scripts/test-runtime.mjs",
